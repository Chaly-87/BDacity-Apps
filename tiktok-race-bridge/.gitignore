# User-supplied commercial music for local preview only.
public/live-track.mp3
# psyfunk.mp3: música OFICIAL do jogo (V5) — tem de ir para produção.
!public/psyfunk.mp3
work/
*.log
*.err

# TTS — só o runtime de produção é versionado:
#   tts/pt_PT-tugao-medium.onnx (+ .json)   voz pt-PT usada pelo jogo
#   tts/linux/**                            Piper Linux x86_64 (Render)
# Tudo o resto é lixo de desenvolvimento local: binário Windows, DLLs,
# voz pt-BR, modelos "cpu.opt" duplicados e amostras de teste.
tts/*.exe
tts/windows/
tts/*.dll
tts/*.wav
tts/*.ok
tts/pt_BR*
tts/*.cpu.opt.onnx
tts/*.cpu.opt.onnx.json
tts/espeak-ng
tts/piper_phonemize
tts/pkgconfig/

